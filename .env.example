# Spotify app credentials — create at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must exactly match a Redirect URI registered in your Spotify app
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/api/auth/callback

# Where the SQLite file lives. Backup-friendly: just copy this file.
DATABASE_PATH=./data/spotify.db

# Server port
PORT=8787
